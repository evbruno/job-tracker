<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    Dashboard
    <:subtitle>Signed in as {@current_scope.user.email}.</:subtitle>
  </.header>

  <section id="dashboard" class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-3">
      <h2 class="card-title">No applications yet</h2>
      <p class="text-sm text-base-content/70">
        Applications, tags, and status history will appear here once those
        features are available.
      </p>
    </div>
  </section>
</Layouts.app>
