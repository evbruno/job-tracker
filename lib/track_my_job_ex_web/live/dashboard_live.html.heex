<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    Dashboard
    <:subtitle>Track your job applications from first interest to final offer.</:subtitle>
  </.header>

  <section id="dashboard" class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-6">
      <div>
        <h2 class="card-title">LiveView check</h2>
        <p class="text-sm text-base-content/70">
          This placeholder confirms that LiveView interactions are wired up.
          Applications, tags, and status tracking arrive in later phases.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <span id="counter" class="text-4xl font-semibold tabular-nums">{@count}</span>

        <div class="flex gap-2">
          <.button id="decrement" phx-click="decrement" aria-label="Decrement counter">
            -1
          </.button>
          <.button id="increment" phx-click="increment" variant="primary">+1</.button>
          <.button id="reset" phx-click="reset">Reset</.button>
        </div>
      </div>
    </div>
  </section>
</Layouts.app>
