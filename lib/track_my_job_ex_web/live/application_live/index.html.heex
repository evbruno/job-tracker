<Layouts.app flash={@flash} current_scope={@current_scope} active={:applications}>
  <.header>
    Applications
    <:subtitle>Track every opportunity, and every step since you applied.</:subtitle>
    <:actions>
      <.link navigate={~p"/applications/new"} id="new-application" class="btn btn-primary btn-sm">
        New application
      </.link>
    </:actions>
  </.header>

  <.form
    :if={@empty_state != :no_applications}
    for={%{}}
    id="application-filters"
    phx-change="filter"
    phx-submit="filter"
    phx-debounce="300"
    class="mt-4 rounded border border-rule bg-surface p-3"
  >
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-12">
      <div class="col-span-2 sm:col-span-3 lg:col-span-3">
        <.input
          type="search"
          name="q"
          id="filter-q"
          label="Search"
          value={@filters.q}
          placeholder="Position or company"
          autocomplete="off"
        />
      </div>
      <div class="lg:col-span-2">
        <.input
          type="select"
          name="status"
          id="filter-status"
          label="Status"
          prompt="All statuses"
          options={status_options(@filter_options)}
          value={@filters.status}
        />
      </div>
      <div class="lg:col-span-2">
        <.input
          type="select"
          name="company"
          id="filter-company"
          label="Company"
          prompt="All companies"
          options={company_options(@filter_options)}
          value={@filters.company}
        />
      </div>
      <div class="lg:col-span-2">
        <.input
          type="select"
          name="recruiter"
          id="filter-recruiter"
          label="Recruiter"
          prompt="All recruiters"
          options={recruiter_options(@filter_options)}
          value={@filters.recruiter}
        />
      </div>
      <div class="lg:col-span-2">
        <.input
          type="select"
          name="archived"
          id="filter-archived"
          label="Archived"
          options={[{"Active only", ""}, {"Archived only", "archived"}, {"All", "all"}]}
          value={archived_filter_value(@filters.archived)}
        />
      </div>
      <div class="lg:col-span-3">
        <.input
          type="select"
          name="sort"
          id="filter-sort"
          label="Sort by"
          options={[{"Created date", "created"}, {"Last updated", "updated"}]}
          value={@filters.sort}
        />
      </div>

      <fieldset class="col-span-2 sm:col-span-3 lg:col-span-12">
        <legend class="mb-1.5 text-[13px] font-medium text-ink">Tags (must have all)</legend>
        <div id="filter-tags" class="flex flex-wrap gap-1.5">
          <label :for={tag <- @filter_options.tags} class="relative inline-flex">
            <input
              type="checkbox"
              name="tags[]"
              value={tag.id}
              checked={selected?(@filters.tags, tag.id)}
              class="peer sr-only"
            />
            <span class={[
              "inline-flex cursor-pointer items-center rounded border border-rule bg-surface px-2 py-1 text-xs text-ink-muted",
              "peer-checked:border-ink peer-checked:bg-ink peer-checked:text-white",
              "peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-cobalt"
            ]}>
              {tag.name}
            </span>
          </label>
          <p :if={@filter_options.tags == []} class="text-xs text-ink-muted">No tags yet.</p>
        </div>
      </fieldset>

      <div class="col-span-2 flex flex-col gap-1.5 sm:col-span-3 lg:col-span-3">
        <span class="text-[13px] font-medium text-ink">Direction</span>
        <button
          type="button"
          id="toggle-sort-direction"
          phx-click="toggle_direction"
          class="inline-flex min-h-9 w-full items-center justify-start gap-1.5 rounded border border-rule bg-surface px-2.5 py-1.5 text-left text-sm text-ink hover:border-ink-muted focus:outline-none focus:ring-2 focus:ring-cobalt/15"
        >
          <.icon name={direction_icon(@filters)} class="size-3.5 shrink-0 text-ink-muted" />
          {direction_label(@filters)}
        </button>
      </div>
    </div>
  </.form>

  <div
    :if={@filters_active? && @empty_state != :no_applications}
    id="active-filters"
    class="mt-3 flex flex-wrap items-center gap-2"
  >
    <span class="text-xs font-medium text-ink-muted">Filters</span>
    <.link
      :for={chip <- @filter_chips}
      patch={chip.path}
      id={chip.id}
      class="inline-flex items-center gap-1 rounded-full border border-rule bg-surface px-2 py-0.5 text-xs text-ink hover:border-ink-muted"
    >
      {chip.label}
      <.icon name="hero-x-mark" class="size-3 text-ink-muted" />
    </.link>
    <.link
      :if={@filter_chips != []}
      patch={~p"/applications"}
      id="clear-filters"
      class="text-xs font-medium text-cobalt hover:underline"
    >
      Clear all
    </.link>
  </div>

  <div
    :if={@total_count > 0}
    class="mt-4 flex items-center justify-between gap-3 border-b border-rule pb-2 text-xs text-ink-muted"
  >
    <p id="applications-range">
      Showing {@range_start}–{@range_end} of {@total_count} applications
    </p>
    <p id="applications-page" class="font-mono">Page {@page} of {@total_pages}</p>
  </div>

  <div
    id="applications"
    phx-update="stream"
    class="mt-3 divide-y divide-rule overflow-hidden rounded border border-rule bg-surface"
  >
    <div
      :for={{dom_id, application} <- @streams.applications}
      id={dom_id}
      class="flex items-stretch"
    >
      <.status_marker slug={application.status.slug} class="status-bar" />

      <.link
        id={"#{dom_id}-link"}
        navigate={~p"/applications/#{application.id}"}
        class="flex min-w-0 flex-1 flex-wrap items-center gap-x-3 gap-y-1 py-2.5 pl-3 pr-2 hover:bg-canvas md:flex-nowrap md:gap-4"
      >
        <div class="w-full min-w-0 md:w-auto md:flex-1">
          <h2 id={"#{dom_id}-position"} class="truncate text-[15px] font-medium text-ink">
            {application.position}
          </h2>
          <div class="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-[13px] text-ink-muted">
            <span id={"#{dom_id}-company"} class="truncate">{application.company_name}</span>
            <span :if={application.tags != []} aria-hidden="true">·</span>
            <span
              :if={application.tags != []}
              id={"#{dom_id}-tags"}
              class="flex flex-wrap items-center gap-1"
            >
              <.tag_chip
                :for={tag <- Enum.sort_by(application.tags, &String.downcase(&1.name))}
                id={"#{dom_id}-tag-#{tag.id}"}
                name={tag.name}
              />
            </span>
          </div>
        </div>

        <div class="flex items-center md:w-40 md:shrink-0">
          <.status_badge status={application.status} id={"#{dom_id}-status"} />
        </div>

        <time
          id={"#{dom_id}-created-at"}
          datetime={DateTime.to_iso8601(application.inserted_at)}
          class="shrink-0 font-mono text-xs tabular-nums text-ink-muted md:w-32"
        >
          {Formatters.format_utc_datetime(application.inserted_at)}
        </time>
      </.link>

      <div class="flex shrink-0 items-center pr-2">
        <button
          type="button"
          id={"delete-application-#{application.id}"}
          phx-click="prompt_delete"
          phx-value-id={application.id}
          aria-label={"Delete " <> application.position}
          title="Delete application"
          class="inline-flex items-center gap-1 rounded p-1.5 text-ink-muted hover:bg-red-50 hover:text-red-700"
        >
          <.icon name="hero-trash" class="size-4" />
          <span class="sr-only md:not-sr-only md:text-xs">Delete</span>
        </button>
      </div>
    </div>
  </div>

  <.empty_state
    :if={@empty_state == :no_applications}
    id="applications-empty"
    icon="hero-briefcase"
    title="No applications yet"
  >
    Add the first opportunity you are tracking. New applications start as
    Interested, and every status change is added to the history.
    <:action>
      <.link navigate={~p"/applications/new"} id="empty-create" class="btn btn-primary btn-sm">
        New application
      </.link>
    </:action>
  </.empty_state>

  <.empty_state
    :if={@empty_state == :no_matches}
    id="applications-no-matches"
    icon="hero-magnifying-glass"
    title="No matching applications"
  >
    Nothing matches the current search and filters. Remove a filter, or search
    for a different company.
    <:action>
      <.link patch={~p"/applications"} id="clear-filters-empty" class="btn btn-primary btn-sm">
        Clear filters
      </.link>
    </:action>
  </.empty_state>

  <div
    :if={@total_count > 0}
    id="applications-pagination"
    class="mt-4 flex items-center justify-between gap-3"
  >
    <p class="hidden text-xs text-ink-muted sm:block">{@page_size} per page</p>
    <div class="flex items-center gap-1">
      <.link
        :if={@page > 1}
        patch={applications_path(@filters, @page - 1)}
        id="pagination-prev"
        class="btn btn-ghost btn-sm"
      >
        Previous
      </.link>
      <span
        :if={@page == 1}
        id="pagination-prev-disabled"
        class="btn btn-ghost btn-sm btn-disabled"
      >
        Previous
      </span>
      <span id="pagination-page" class="px-2 font-mono text-xs tabular-nums">
        Page {@page} of {@total_pages}
      </span>
      <.link
        :if={@page < @total_pages}
        patch={applications_path(@filters, @page + 1)}
        id="pagination-next"
        class="btn btn-ghost btn-sm"
      >
        Next
      </.link>
      <span
        :if={@page == @total_pages}
        id="pagination-next-disabled"
        class="btn btn-ghost btn-sm btn-disabled"
      >
        Next
      </span>
    </div>
  </div>

  <.confirm_modal
    :if={@pending_delete}
    id="delete-application-modal"
    title="Delete application?"
    confirm_label="Delete application"
    confirm_event="delete"
    confirm_value={@pending_delete.id}
  >
    <p>
      <span class="font-medium text-ink">{@pending_delete.position}</span>
      at {@pending_delete.company_name} will be permanently deleted, along with
      its status history and its tag links. The tags themselves are kept.
    </p>
  </.confirm_modal>
</Layouts.app>
