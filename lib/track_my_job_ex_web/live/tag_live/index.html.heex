<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    Tags
    <:subtitle>
      Rename or delete your tags. Deleting a tag removes it from applications.
    </:subtitle>
  </.header>

  <div id="tags" phx-update="stream" class="flex flex-col gap-2">
    <div
      :for={{dom_id, tag} <- @streams.tags}
      id={dom_id}
      class="card border border-base-300 bg-base-100 shadow-sm"
    >
      <div class="card-body p-4">
        <%= if @editing_tag_id == tag.id do %>
          <.form
            for={@rename_form}
            id={"rename-tag-#{tag.id}"}
            phx-submit="rename"
            class="flex flex-wrap items-end gap-2"
          >
            <.input type="hidden" name="tag[id]" id={"rename-tag-id-#{tag.id}"} value={tag.id} />
            <.input
              field={@rename_form[:name]}
              id={"tag-name-input-#{tag.id}"}
              label="Name"
              maxlength="50"
              required
            />
            <div class="flex gap-2">
              <button type="submit" id={"save-tag-#{tag.id}"} class="btn btn-primary btn-sm">
                Save
              </button>
              <button
                type="button"
                id={"cancel-edit-tag-#{tag.id}"}
                phx-click="cancel_edit"
                class="btn btn-ghost btn-sm"
              >
                Cancel
              </button>
            </div>
          </.form>
        <% else %>
          <div class="flex flex-wrap items-center justify-between gap-3">
            <span id={"tag-name-#{tag.id}"} class="font-medium">{tag.name}</span>
            <div class="flex gap-2">
              <button
                type="button"
                id={"edit-tag-#{tag.id}"}
                phx-click="edit"
                phx-value-id={tag.id}
                class="btn btn-ghost btn-sm"
              >
                Rename
              </button>
              <button
                type="button"
                id={"delete-tag-#{tag.id}"}
                phx-click="delete"
                phx-value-id={tag.id}
                data-confirm="Delete this tag? It will be removed from all applications."
                class="btn btn-error btn-outline btn-sm"
              >
                Delete
              </button>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div
    :if={@tags_empty?}
    id="tags-empty"
    class="card border border-dashed border-base-300 bg-base-100"
  >
    <div class="card-body items-center text-center">
      <.icon name="hero-tag" class="size-10 text-base-content/40" />
      <h2 class="card-title">No tags yet</h2>
      <p class="text-sm text-base-content/70">
        Create tags while creating or editing an application.
      </p>
    </div>
  </div>
</Layouts.app>
