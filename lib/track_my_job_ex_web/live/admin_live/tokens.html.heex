<Layouts.app flash={@flash} current_scope={@current_scope} active={:admin}>
  <div class="mb-4">
    <.link
      navigate={~p"/admin"}
      class="inline-flex items-center gap-1 text-xs font-medium text-cobalt hover:underline"
    >
      <.icon name="hero-arrow-left" class="size-3.5" /> Admin · Users
    </.link>
  </div>

  <.header>
    Admin · MCP tokens
    <:subtitle>
      Create, list, and revoke MCP tokens for any user. Administrators only.
    </:subtitle>
  </.header>

  <div
    :if={@new_token}
    id="new-admin-mcp-token"
    class="mt-4 rounded border border-amber-300 bg-amber-50 p-4"
  >
    <p class="text-sm font-semibold text-amber-900">
      Copy this token now. It will not be shown again.
    </p>
    <input
      id="new-admin-mcp-token-value"
      type="text"
      readonly
      value={@new_token}
      class="mt-2 w-full rounded border border-amber-300 bg-white px-2 py-1 font-mono text-xs text-ink"
    />
    <button
      type="button"
      id="dismiss-new-admin-mcp-token"
      phx-click="dismiss_token"
      class="btn btn-ghost btn-sm mt-2"
    >
      Dismiss
    </button>
  </div>

  <div class="mt-6 rounded border border-rule bg-surface p-4">
    <h2 class="text-sm font-semibold text-ink">Create a token for a user</h2>

    <.form
      for={@create_form}
      id="create-admin-mcp-token-form"
      phx-submit="create"
      class="mt-3 flex flex-wrap items-end gap-3"
    >
      <div class="min-w-48 flex-1">
        <.input
          field={@create_form[:user_id]}
          id="admin-mcp-token-user"
          type="select"
          label="User"
          options={Enum.map(@users, &{&1.email, &1.id})}
          required
        />
      </div>
      <div class="min-w-48 flex-1">
        <.input
          field={@create_form[:name]}
          id="admin-mcp-token-name"
          type="text"
          label="Name"
          required
        />
      </div>
      <div class="w-32">
        <.input
          field={@create_form[:expires_in]}
          id="admin-mcp-token-expires-in"
          type="number"
          label="Expires in (days)"
          min="1"
        />
      </div>
      <button type="submit" id="create-admin-mcp-token" class="btn btn-primary btn-sm">
        Create token
      </button>
    </.form>
  </div>

  <div class="mt-6 divide-y divide-rule overflow-hidden rounded border border-rule bg-surface">
    <div
      :for={token <- @tokens}
      id={"admin-mcp-token-#{token.id}"}
      class="flex flex-wrap items-center justify-between gap-2 px-3 py-2.5"
    >
      <div class="min-w-0">
        <span class="text-sm font-medium text-ink">
          {token.name}
        </span>
        <p class="font-mono text-xs text-ink-muted">
          {token.token_prefix}… · {token.user.email}
        </p>
      </div>
      <div class="flex items-center gap-2 text-xs text-ink-muted">
        <span>Created {Calendar.strftime(token.inserted_at, "%Y-%m-%d")}</span>
        <button
          type="button"
          id={"revoke-admin-mcp-token-#{token.id}"}
          phx-click="prompt_delete"
          phx-value-id={token.id}
          class="btn btn-ghost btn-sm text-red-700 hover:bg-red-50"
        >
          Revoke
        </button>
      </div>
    </div>
  </div>

  <.empty_state
    :if={@tokens_empty?}
    id="admin-mcp-tokens-empty"
    icon="hero-key"
    title="No tokens yet"
  >
    Create a token above.
  </.empty_state>

  <.confirm_modal
    :if={@pending_delete}
    id="revoke-admin-mcp-token-modal"
    title="Revoke token?"
    confirm_label="Revoke token"
    confirm_event="delete"
    confirm_value={@pending_delete.id}
  >
    <p>
      <span class="font-medium text-ink">{@pending_delete.name}</span>
      for {@pending_delete.user.email} will stop authenticating immediately.
    </p>
  </.confirm_modal>
</Layouts.app>
